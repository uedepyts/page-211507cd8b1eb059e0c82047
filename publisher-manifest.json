items: center;gap: 0.75rem}\n.plan-name {font-size: 1.25rem;font-weight: 700;color: #0f172a}\n.plan-tag {background-color: #0891b2;color: #ffffff;font-size: 0.75rem;font-weight: 700;padding: 0.2rem 0.6rem;border-radius: 0.5rem}\n.plan-pricing {text-align: right}\n.price-main {font-size: 1.5rem;font-weight: 800;color: #0891b2}\n.price-sub {font-size: 0.825rem;color: #64748b}\n.plan-specs {display: grid;grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));gap: 0.5rem}\n.spec-item {font-size: 0.9rem;color: #475569;background: #f8fafc;padding: 0.5rem 0.75rem;border-radius: 0.5rem}\n.step-list {display: grid;gap: 1rem}\n.step-item {background: #f8fafc;border-radius: 0.85rem;padding: 1.25rem}\n.step-num {font-size: 0.8rem;font-weight: 800;color: #0891b2;text-transform: uppercase;margin-bottom: 0.25rem}\n.step-title {font-size: 1.05rem;font-weight: 700;color: #0f172a;margin-bottom: 0.35rem}\n.step-desc {font-size: 0.9rem;color: #475569}\n.clients-grid {display: grid;grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));gap: 1rem}\n.client-box {background: #f8fafc;padding: 1.25rem;border-radius: 0.85rem}\n.client-box h3 {font-size: 1.05rem;color: #0f172a;margin-bottom: 0.5rem}\n.client-box p {font-size: 0.875rem;color: #475569}\n.client-box a.client-link {display: inline-block;margin-top: 0.75rem;font-size: 0.825rem;font-weight: 600;color: #0891b2;text-decoration: none}\nol.faq-list {list-style: none;counter-reset: faq-counter;display: flex;flex-direction: column;gap: 1.25rem}\nli.faq-item {counter-increment: faq-counter;position: relative;padding-left: 3rem}\nli.faq-item::before {content: counter(faq-counter, decimal-leading-zero);position: absolute;left: 0;top: 0;font-size: 1.1rem;font-weight: 800;color: #0891b2}\n.faq-question {font-size: 1.05rem;font-weight: 700;color: #0f172a;margin-bottom: 0.35rem}\n.faq-answer {font-size: 0.925rem;color: #475569}\nfooter {text-align: center;font-size: 0.85rem;color: #64748b;margin-top: 3rem}\n@media (max-width: 640px) {\n  header.hero-narrative {padding: 2rem 1.5rem}\n  h1 {font-size: 1.75rem}\n  .plan-header {flex-direction: column;align-items: flex-start}\n  .plan-pricing {text-align: left}\n}\n</style><main class=\"page-container\">\n\n  <header class=\"hero-narrative\">\n    <span class=\"kicker\">网络通道备忘录</span>\n    <h1>MorckVPN 架构规范与订购指南</h1>\n    <div class=\"narrative-body\">\n      <p class=\"lead\">通道的意义在于交付可预期的连通性。不需要复杂的修饰，只讲求明确的技术指标与规则。</p>\n      <p>互联网协议本身并不具备情感。数据包的跨区域中继，核心在于稳定的链路分配、合理的负载约束，以及清晰透明的账户计量。MorckVPN 面向需要独立配置通道的个人与组织，提供具备边界保证的订阅方案。</p>\n      <p>所有节点按需编排，客户端逻辑保持极简。阅读以下章节，选择相匹配的吞吐能力与终端指标。</p>\n    </div>\n    <nav class=\"hero-nav\" aria-label=\"页面章节导航\">\n      <a href=\"#plans\">订购方案</a>\n      <a href=\"#setup\">配置指引</a>\n      <a href=\"#platforms\">终端说明</a>\n      <a href=\"#faq\">常见答疑</a>\n    </nav>\n  </header>\n\n  <section id=\"plans\">\n    <h2 class=\"section-title\">订阅规格与配额</h2>\n    <div class=\"card\">\n      <div class=\"plan-row\">\n        <div class=\"plan-header\">\n          <div class=\"plan-name-wrap\">\n            <span class=\"plan-name\">基础版</span>\n          </div>\n          <div class=\"plan-pricing\">\n            <span class=\"price-main\">¥15/月</span>\n            <span class=\"price-sub\">（按年付仅需 ¥150/年）</span>\n          </div>\n        </div>\n        <div class=\"plan-specs\">\n          <div class=\"spec-item\">每月 100GB 极速流量</div>\n          <div class=\"spec-item\">支持 3 台设备同时在线</div>\n          <div class=\"spec-item\">解锁基础流媒体</div>\n          <div class=\"spec-item\">普通线路节点池</div>\n        </div>\n      </div>\n\n      <div class=\"plan-row\">\n        <div class=\"plan-header\">\n          <div class=\"plan-name-wrap\">\n            <span class=\"plan-name\">旗舰版</span>\n            <span class=\"plan-tag\">推荐</span>\n          </div>\n          <div class=\"plan-pricing\">\n            <span class=\"price-main\">¥35/月</span>\n            <span class=\"price-sub\">（按年付仅需 ¥350/年）</span>\n          </div>\n        </div>\n        <div class=\"plan-specs\">\n          <div class=\"spec-item\">每月 300GB 极速流量</div>\n          <div class=\"spec-item\">支持 5 台设备同时在线</div>\n          <div class=\"spec-item\">全节点原生流媒体解锁</div>\n          <div class=\"spec-item\">IPLC 专线游戏加速优化</div>\n          <div class=\"spec-item\">7x24 优先工单支持</div>\n        </div>\n      </div>\n\n      <div class=\"plan-row\">\n        <div class=\"plan-header\">\n          <div class=\"plan-name-wrap\">\n            <span class=\"plan-name\">团队版</span>\n          </div>\n          <div class=\"plan-pricing\">\n            <span class=\"price-main\">¥85/月</span>\n            <span class=\"price-sub\">（按年付仅需 ¥850/年）</span>\n          </div>\n        </div>\n        <div class=\"plan-specs\">\n          <div class=\"spec-item\">每月 1000GB 极速流量</div>\n          <div class=\"spec-item\">支持 20 台设备同时在线</div>\n          <div class=\"spec-item\">VIP 专属高带宽节点</div>\n          <div class=\"spec-item\">支持企业定制路由</div>\n          <div class=\"spec-item\">专属客户经理服务</div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"setup\">\n    <h2 class=\"section-title\">接入执行步骤</h2>\n    <div class=\"card\">\n      <div class=\"step-list\">\n        <div class=\"step-item\">\n          <div class=\"step-num\">Step 01</div>\n          <div class=\"step-title\">确立订阅方案</div>\n          <div class=\"step-desc\">核对设备数与月度流量。完成结算后生成专属配置密匙。</div>\n        </div>\n        <div class=\"step-item\">\n          <div class=\"step-num\">Step 02</div>\n          <div class=\"step-title\">导入订阅数据</div>\n          <div class=\"step-desc\">将订阅链接填入支持的标准客户端中，拉取节点集群清单。</div>\n        </div>\n        <div class=\"step-item\">\n          <div class=\"step-num\">Step 03</div>\n          <div class=\"step-title\">建立加密握手</div>\n          <div class=\"step-desc\">选择目标路由区域。开启分流策略，完成连通性校验。</div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"platforms\">\n    <h2 class=\"section-title\">终端与接入软件</h2>\n    <div class=\"card\">\n      <div class=\"clients-grid\">\n        <div class=\"client-box\">\n          <h3>桌面工作站</h3>\n          <p>适用于 Windows 与 macOS 操作系统。推荐使用主流通用代理工具导入链接。</p>\n          <a class=\"client-link\" href=\"#\">查看配置文档 →</a>\n        </div>\n        <div class=\"client-box\">\n          <h3>移动终端</h3>\n          <p>兼容 iOS 与 Android 系统生态。配合对应平台的通用客户端直接同步节点。</p>\n          <a class=\"client-link\" href=\"#\">获取指引 →</a>\n        </div>\n        <div class=\"client-box\">\n          <h3>网关与路由</h3>\n          <p>支持基于 OpenWrt 的路由器配置。可在家庭或团队内网实现透明转发。</p>\n          <a class=\"client-link\" href=\"#\">路由指引 →</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <h2 class=\"section-title\">常见问题解答</h2>\n    <div class=\"card\">\n      <ol class=\"faq-list\">\n        <li class=\"faq-item\">\n          <div class=\"faq-question\">流量重置周期如何计算？</div>\n          <div class=\"faq-answer\">系统自开通时刻起按自然月周期运行。次月同日重置配额，当期未使用额度不滚存。</div>\n        </li>\n        <li class=\"faq-item\">\n          <div class=\"faq-question\">超过在线设备限制会怎样？</div>\n          <div class=\"faq-answer\">后发起的设备连接将被阻断。若要扩展连接数，可随时升级至更高档位方案。</div>\n        </li>\n        <li class=\"faq-item\">\n          <div class=\"faq-question\">方案是否包含官方定制客户端？</div>\n          <div class=\"faq-answer\">目前优先适配行业通用协议客户端。根据各系统指南配置即可使用，无需绑定单一程序。</div>\n        </li>\n      </ol>\n    </div>\n  </section>\n\n  <footer>\n    <p>© MorckVPN 平台规范与订购指南。所有规格以面板实际显示为准。</p>\n  </footer>\n\n</main>",
